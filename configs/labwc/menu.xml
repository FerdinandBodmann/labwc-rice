<?xml version="1.0"?>
<!--
  Ultimate Labwc Rice - menu.xml
  Root (desktop right-click / Super+Left-click) menu for labwc

  Reference: https://labwc.github.io/labwc-menu.5.html
-->
<openbox_menu>

  <menu id="root-menu" label="Labwc">
    <item label="Terminal">
      <action name="Execute" command="kitty" />
    </item>
    <item label="File Manager">
      <action name="Execute" command="thunar" />
    </item>
    <item label="Web Browser">
      <action name="Execute" command="firefox" />
    </item>
    <item label="Text Editor">
      <action name="Execute" command="code" />
    </item>
    <item label="Application Launcher">
      <action name="Execute" command="fuzzel" />
    </item>

    <separator />

    <menu id="utilities" label="Utilities">
      <item label="Audio Settings">
        <action name="Execute" command="pavucontrol" />
      </item>
      <item label="Network Settings">
        <action name="Execute" command="nm-connection-editor" />
      </item>
      <item label="Bluetooth">
        <action name="Execute" command="blueman-manager" />
      </item>
      <separator />
      <item label="Screenshot (region)">
        <action name="Execute" command="screenshot" />
      </item>
      <item label="Set Wallpaper">
        <action name="Execute" command="wallpaper-switcher" />
      </item>
    </menu>

    <separator />

    <item label="Lock Screen">
      <action name="Execute" command="swaylock -f" />
    </item>
    <item label="Reconfigure labwc">
      <action name="Reconfigure" />
    </item>
    <item label="Exit labwc">
      <action name="Exit" />
    </item>
  </menu>

</openbox_menu>
