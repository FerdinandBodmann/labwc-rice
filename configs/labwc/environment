#
# Ultimate Labwc Rice - environment
#
# These lines are parsed directly by labwc - they are NOT a shell script.
# Use plain `VARIABLE=value`, do not use `export`, and do not quote values.
# Reference: https://labwc.github.io/labwc-config.5.html
#
# NOTE: labwc sets WAYLAND_DISPLAY and DISPLAY itself, do not set them here.

# Toolkit backends
GDK_BACKEND=wayland,x11
QT_QPA_PLATFORM=wayland;xcb
SDL_VIDEODRIVER=wayland
CLUTTER_BACKEND=wayland

# Firefox / Chromium / Electron on Wayland
MOZ_ENABLE_WAYLAND=1
ELECTRON_OZONE_PLATFORM_HINT=wayland

# Java applications on Wayland
_JAVA_AWT_WM_NONREPARENTING=1

# Cursor theme (installed: Bibata-Modern-Ice)
XCURSOR_THEME=Bibata-Modern-Ice
XCURSOR_SIZE=24

# Keyboard layout (uncomment and adjust to taste, e.g. a German layout)
#XKB_DEFAULT_LAYOUT=de
#XKB_DEFAULT_VARIANT=
#XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle
