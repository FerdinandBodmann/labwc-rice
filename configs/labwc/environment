#
# Ultimate Labwc Rice - environment
#
# These lines are parsed directly by labwc - they are NOT a shell script.
# Use plain `VARIABLE=value`, do not use `export`, and do not quote values.
# Reference: https://labwc.github.io/labwc-config.5.html
#
# NOTE: labwc sets WAYLAND_DISPLAY and DISPLAY itself, do not set them here.

# Toolkit backends
GDK_BACKEND=wayland,x11
QT_QPA_PLATFORM=wayland;xcb
SDL_VIDEODRIVER=wayland
CLUTTER_BACKEND=wayland

# Firefox / Chromium / Electron on Wayland
MOZ_ENABLE_WAYLAND=1
ELECTRON_OZONE_PLATFORM_HINT=wayland

# Java applications on Wayland
_JAVA_AWT_WM_NONREPARENTING=1

# Cursor theme (installed: Bibata-Modern-Ice)
XCURSOR_THEME=Bibata-Modern-Ice
XCURSOR_SIZE=24

# Keyboard layout (German, matching the system-wide localectl setting)
XKB_DEFAULT_LAYOUT=de
XKB_DEFAULT_MODEL=pc105
# Optional tweaks, uncomment as needed:
#XKB_DEFAULT_VARIANT=nodeadkeys
# Add a second layout and toggle it with Alt+Shift:
#XKB_DEFAULT_LAYOUT=de,us
#XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle
# Or swap Caps Lock for Escape:
#XKB_DEFAULT_OPTIONS=caps:escape
