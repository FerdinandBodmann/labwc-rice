#!/bin/sh
#
# Ultimate Labwc Rice - autostart
# Executed as a shell script by labwc after the session is set up.
#
# Every block is guarded with `command -v` so a missing program is harmless.
# Reference: https://labwc.github.io/labwc-config.5.html

# --- Polkit authentication agent (for GUI privilege prompts) -----------------
if command -v polkit-gnome-authentication-agent-1 >/dev/null 2>&1; then
    polkit-gnome-authentication-agent-1 &
elif [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
elif command -v lxpolkit >/dev/null 2>&1; then
    lxpolkit &
elif command -v xfce-polkit >/dev/null 2>&1; then
    xfce-polkit &
fi

# --- Panel --------------------------------------------------------------------
command -v waybar >/dev/null 2>&1 && waybar &

# --- Notifications ------------------------------------------------------------
command -v mako >/dev/null 2>&1 && mako &
command -v dunst >/dev/null 2>&1 && dunst &

# --- Wallpaper ----------------------------------------------------------------
# Re-applies the wallpaper last chosen with `wallpaper-switcher`
# (Super+Shift+w, or "Set Wallpaper" in the desktop menu). Falls back to a
# random one, then to a solid Catppuccin Mocha colour.
wallpaper_picker=""
for picker in "$HOME/.local/bin/wallpaper-switcher" "$HOME/labwc-rice/scripts/wallpaper-switcher.sh"; do
    if [ -x "$picker" ]; then
        wallpaper_picker="$picker"
        break
    fi
done

if [ -n "$wallpaper_picker" ]; then
    "$wallpaper_picker" --restore &
elif command -v swaybg >/dev/null 2>&1; then
    swaybg -c '#1e1e2e' &
fi

# --- Clipboard history --------------------------------------------------------
# Browse the history with: cliphist list | fuzzel --dmenu | cliphist decode | wl-copy
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    wl-paste --watch cliphist store &
fi

# --- Status applets -----------------------------------------------------------
command -v nm-applet >/dev/null 2>&1 && nm-applet &
command -v blueman-applet >/dev/null 2>&1 && blueman-applet &

# --- Output profiles (per-monitor setup, optional) ----------------------------
if command -v kanshi >/dev/null 2>&1 && [ -f "$HOME/.config/kanshi/config" ]; then
    kanshi &
fi

# --- Idle management ----------------------------------------------------------
if command -v swayidle >/dev/null 2>&1 && command -v swaylock >/dev/null 2>&1; then
    swayidle -w \
        timeout 600 'swaylock -f' \
        timeout 900 'wlopm --off "*"' \
        resume 'wlopm --on "*"' \
        before-sleep 'swaylock -f' &
fi

# --- Night light (optional) ---------------------------------------------------
command -v wlsunset >/dev/null 2>&1 && wlsunset -S 07:00 -s 21:00 &

# --- Extra user hooks ---------------------------------------------------------
if [ -d "$HOME/.config/labwc/autostart.d" ]; then
    for script in "$HOME/.config/labwc/autostart.d"/*.sh; do
        [ -x "$script" ] && "$script" &
    done
fi
