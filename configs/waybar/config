{
    "layer": "top",
    "position": "top",
    "spacing": 6,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "custom/launcher",
        "ext/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "bluetooth",
        "network",
        "cpu",
        "memory",
        "tray"
    ],
    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "fuzzel"
    },
    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " mute",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "bluetooth": {
        "format": "{icon}",
        "format-on": "{icon}",
        "format-off": "{icon}",
        "format-connected": "{icon} {num_connections}",
        "format-no-controller": "{icon}",
        "format-icons": {
            "default": "",
            "on": "",
            "off": "",
            "connected": ""
        },
        "tooltip-format": "{controller_alias}  {controller_address}",
        "tooltip-format-on": "{controller_alias}  {controller_address}\nBluetooth on — click to manage devices",
        "tooltip-format-off": "Bluetooth off — click to manage devices",
        "tooltip-format-connected": "{controller_alias}  {controller_address}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  {device_alias}  {device_address}",
        "tooltip-format-no-controller": "No Bluetooth adapter",
        "on-click": "/home/imgsh/.local/bin/bluetooth-panel",
        "on-click-right": "bluetoothctl power toggle"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": " offline",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "nm-connection-editor"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 5
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 10
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
